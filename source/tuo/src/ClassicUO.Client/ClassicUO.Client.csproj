<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>cuoicon.ico</ApplicationIcon>
    <AssemblyName>TazUO</AssemblyName>
    <RootNamespace>ClassicUO</RootNamespace>
    <AssemblyVersion>5.3.62</AssemblyVersion>
    <FileVersion>5.3.62</FileVersion>
    <PackageProjectUrl>https://github.com/PlayTazUO/TazUO</PackageProjectUrl>
    <PublishAot>false</PublishAot>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Forces generated sources (incl. source generators) to be written to disk -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!-- v0.7.8: bake the web-client version into a strongly-typed assembly
       attribute so the TUO LoginGump label can show "TazUO Web Foss vX.Y.Z"
       instead of the upstream "TazUO Version 5.1.0". Default is set here
       so a bare dotnet-build from source still has a sane string;
       release.bat / build.bat override it with the real release tag via
       p:WebClientVersion=v0.7.8. Iterative builds (no release tag) get
       git describe (tags + always + dirty) from build.bat as a fallback,
       mirroring source/cuo/src/ClassicUO.Client/ClassicUO.Client.csproj. -->
  <PropertyGroup>
    <WebClientVersion Condition="'$(WebClientVersion)' == ''">v0.7.8-dev</WebClientVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WebClientVersion</_Parameter1>
      <_Parameter2>$(WebClientVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputPath>$(ProjectDir)..\..\bin\Release\</OutputPath>
    <PublishDir>$(ProjectDir)..\..\bin\dist\</PublishDir>
    <Optimize>true</Optimize>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputPath>$(ProjectDir)..\..\bin\Debug\</OutputPath>
    <DefineConstants>$(DefineConstants)TRACE</DefineConstants>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IS_DEV_BUILD)' == 'true'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClassicUO.UnitTests</_Parameter1>
    </AssemblyAttribute>
    <!-- WebClient WASM-fork (2026-05-26): the tazuo-wasm wrapper csproj
         lives at source/webclient/tazuo-wasm/ and needs internal access
         to Client/Bootstrap/UIManager/ProfileManager. Additive — does
         not change desktop visibility because tazuo-wasm only references
         this csproj under IsBrowserWasm=true. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute"
                       Condition="'$(IsBrowserWasm)' == 'true'">
      <_Parameter1>tazuo-wasm</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\FNA\FNA.Core.csproj" />
    <ProjectReference Include="..\ClassicUO.Assets\ClassicUO.Assets.csproj" />
    <ProjectReference Include="..\ClassicUO.Renderer\ClassicUO.Renderer.csproj" />
    <ProjectReference Include="..\ClassicUO.Utility\ClassicUO.Utility.csproj" />
    <ProjectReference Include="..\ClassicUO.CUOAPI\ClassicUO.CUOAPI.csproj" />
    <ProjectReference Include="..\..\tools\EventGenerator\EventGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ClassicUO.SourceGenerators\ClassicUO.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Async.IRC\Async.IRC.csproj" />
    <ProjectReference Include="..\..\external\Myra\src\Myra\Myra.FNA.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\ResErrorMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ResErrorMessages.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\ResGeneral.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ResGeneral.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\ResGumps.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ResGumps.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\ResErrorMessages.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ResErrorMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ResGeneral.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ResGeneral.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ResGumps.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ResGumps.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <DataFiles_iplib Include="$(ProjectDir)..\..\external\iplib\**\*.*" />
    <DataFiles_x64 Include="$(ProjectDir)..\..\external\x64\*.*" />
    <DataFiles_win-arm Include="$(ProjectDir)..\..\external\win-arm\*.*" />
    <DataFiles_lib64 Include="$(ProjectDir)..\..\external\lib64\*.*" />
    <DataFiles_osx Include="$(ProjectDir)..\..\external\osx\*.*" />
    <DataFiles_osx-arm Include="$(ProjectDir)..\..\external\osx-arm\*.*" />
    <DataFiles_vulkan Include="$(ProjectDir)..\..\external\vulkan\icd.d\*.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Game\Managers\DefaultSpellIndicatorConfig.json" />
    <EmbeddedResource Include="Configuration\language.ini" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IronPython" Version="3.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.12.0" />
    <PackageReference Include="Vosk" Version="0.3.38" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Windows: use RuntimeIdentifier if set, otherwise fall back -->
    <_IsWindows Condition="
    ('$([System.String]::IsNullOrEmpty($(RuntimeIdentifier)))' == 'true' AND
     '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true')
    OR
    ('$([System.String]::IsNullOrEmpty($(RuntimeIdentifier)))' == 'false' AND
     $(RuntimeIdentifier.StartsWith('win')) )
  ">true</_IsWindows>

    <!-- MacOS -->
    <_IsMacOS Condition="
    ('$([System.String]::IsNullOrEmpty($(RuntimeIdentifier)))' == 'true' AND
     '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true')
    OR
    ('$([System.String]::IsNullOrEmpty($(RuntimeIdentifier)))' == 'false' AND
     $(RuntimeIdentifier.StartsWith('osx')) )
  ">true</_IsMacOS>

    <!-- Linux -->
    <_IsLinux Condition="
    ('$([System.String]::IsNullOrEmpty($(RuntimeIdentifier)))' == 'true' AND
     '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true')
    OR
    ('$([System.String]::IsNullOrEmpty($(RuntimeIdentifier)))' == 'false' AND
     $(RuntimeIdentifier.StartsWith('linux')) )
  ">true</_IsLinux>
  </PropertyGroup>

  <Target Name="IncludeGeneratedFiles" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <None Include="$(BaseIntermediateOutputPath)/generated/EventGenerator/**/*.Api.Decl.g.cs" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <DocSourceFiles Include="$(ProjectDir)/LegionScripting/ApiClasses/*.cs" />
    <DocSourceFiles Include="LegionScripting\LegionAPI.cs" />
    <DocSourceFiles Include="$(BaseIntermediateOutputPath)/generated/EventGenerator/**/*.Api.Decl.g.cs" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Create a string of quoted paths -->
    <DocFileArgs>@(DocSourceFiles->'"%(FullPath)"', ' ')</DocFileArgs>
  </PropertyGroup>

  <Target Name="GenerateDocs" AfterTargets="Build" Condition="'$(IsBrowserWasm)' != 'true'">
    <Message Text="Running: dotnet run --project ../APIToMarkdown/APIToMarkdown.csproj $(DocFileArgs)" />
    <Exec Command='dotnet run --project ../APIToMarkdown/APIToMarkdown.csproj "$(ProjectDir)/LegionScripting/docs" $(DocFileArgs)' />
  </Target>

  <Target Name="CreateVersionFile" AfterTargets="Build">
    <WriteLinesToFile File="$(TargetDir)v.txt" Lines="$(AssemblyVersion)" Overwrite="true" />
  </Target>

  <Target Name="CopyExternalDeps_build" AfterTargets="Build">
    <Copy SourceFiles="@(DataFiles_iplib)" DestinationFiles="@(DataFiles_iplib -> '$(TargetDir)\iplib\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_x64)" DestinationFolder="$(TargetDir)\x64\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_win-arm)" DestinationFolder="$(TargetDir)\win-arm\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_lib64)" DestinationFolder="$(TargetDir)\lib64\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_osx)" DestinationFolder="$(TargetDir)\osx\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_osx-arm)" DestinationFolder="$(TargetDir)\osx-arm\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_vulkan)" DestinationFolder="$(TargetDir)\vulkan\icd.d\" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CreateVersionFile_publish" AfterTargets="Publish">
    <WriteLinesToFile File="$(PublishDir)v.txt" Lines="$(AssemblyVersion)" Overwrite="true" />
  </Target>

  <Target Name="CopyExternalDeps_publish" AfterTargets="Publish">
    <Copy SourceFiles="@(DataFiles_iplib)" DestinationFiles="@(DataFiles_iplib -> '$(PublishDir)\iplib\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_x64)" DestinationFolder="$(PublishDir)\x64\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_win-arm)" DestinationFolder="$(PublishDir)\win-arm\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_lib64)" DestinationFolder="$(PublishDir)\lib64\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_osx)" DestinationFolder="$(PublishDir)\osx\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_vulkan)" DestinationFolder="$(PublishDir)\vulkan\icd.d\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_osx-arm)" DestinationFolder="$(PublishDir)\osx-arm\" SkipUnchangedFiles="true" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════
       BEGIN WebClient WASM-fork patches (additive — desktop unaffected)
       Added 2026-05-26 when TUO was vendored for the multi-client web
       port. All blocks guarded by IsBrowserWasm=true; the desktop build
       (no IsBrowserWasm flag) sees none of this and behaves identically
       to upstream TazUO.

       Operator decisions 2026-05-26 (drop these for WASM build):
         - IronPython 3.4.2 (LegionScripting Python interpreter)
         - Microsoft.CodeAnalysis.CSharp.Scripting 4.12.0 (Roslyn runtime)
         - Async.IRC.csproj (raw TCP, browser can't open)
         - Vosk 0.3.38 (speech recognition native binary)
         - Microsoft.Data.Sqlite 8.0.0 (LegionScripting persistent vars)

       To re-enable a feature for WASM later: delete the matching
       <Remove> below and (if needed) #if-guard the source uses. See
       docs/tuo/LESSONS_FROM_CUO.md for the full inventory + rationale.

       Reapply on every upstream re-vendor; source/tuo/UPSTREAM.md has
       the procedure.
       ═══════════════════════════════════════════════════════════════════ -->

  <PropertyGroup Condition="'$(IsBrowserWasm)' == 'true'">
    <!-- Flip Exe-targeted upstream TazUO into Library mode so the WASM
         wrapper csproj (source/webclient/tazuo-wasm/) can host it.
         Drops PublishAot (browser-wasm doesn't support it). Adds the
         BROWSER_WASM define so source #if guards activate. -->
    <OutputType>Library</OutputType>
    <PublishAot>false</PublishAot>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DefineConstants>$(DefineConstants);BROWSER_WASM</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsBrowserWasm)' == 'true'">
    <!-- Out-of-scope project + package refs for the WASM build. -->
    <ProjectReference Remove="..\Async.IRC\Async.IRC.csproj" />
    <PackageReference Remove="IronPython" />
    <PackageReference Remove="Microsoft.CodeAnalysis.CSharp.Scripting" />
    <PackageReference Remove="Microsoft.Data.Sqlite" />
    <PackageReference Remove="Vosk" />
    <!-- Myra + FontStashSharp + XNAssets stay in for the first try.
         If Mercury MT AOT chokes on them, additional <Remove> lines
         get added here. -->
  </ItemGroup>

  <ItemGroup Condition="'$(IsBrowserWasm)' == 'true'">
    <!-- Strip source dirs/files that DIRECTLY reference the removed
         dependencies. Other files with stray `using` clauses get
         #if !BROWSER_WASM guards at the source level (see source-side
         patches; tracked in docs/tuo/LESSONS_FROM_CUO.md). -->
    <Compile Remove="LegionScripting\**\*.cs" />
    <Compile Remove="Game\UI\MyraWindows\Script*.cs" />
    <Compile Remove="Game\UI\MyraWindows\PersistentVarsWindow.cs" />
    <Compile Remove="Game\UI\MyraWindows\RunningScriptsWindow.cs" />
    <Compile Remove="Game\UI\MyraWindows\TazUOChatWindow.cs" />
    <Compile Remove="Game\Managers\VoiceRecognitionManager.cs" />
    <Compile Remove="Game\Managers\TazUOChatManager.cs" />
    <Compile Remove="Game\Managers\FriendliesSQLManager.cs" />
    <Compile Remove="Game\Managers\ItemDatabaseManager.cs" />
    <Compile Remove="Game\Managers\SQLSettingsManager.cs" />
    <!-- The ItemDatabase Myra UI (Widgets\Assistant\ItemDatabase\) is
         RE-INCLUDED in the WASM build (v0.8.33): the SQLite-backed
         ItemDatabaseManager is reimplemented in-memory + IDBFS-persisted
         (ItemDatabaseManager.Wasm.cs), so the UI works again on web. The
         original SQLite .cs managers above stay removed; the .Wasm.cs
         replacements compile in their place. -->
    <!-- WasmStubs.cs provides empty placeholder types for the
         LegionScripting / TazUOChatManager / etc. references that
         EventSink.cs + Profile.cs + GameScene.cs still mention.
         It compiles only under BROWSER_WASM. -->
  </ItemGroup>

  <!-- END WebClient WASM-fork patches ═══════════════════════════════════ -->

</Project>
