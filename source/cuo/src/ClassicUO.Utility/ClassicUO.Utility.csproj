<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Propagate BROWSER_WASM so wasm-only helpers (e.g. ZoneLoadDiag)
       are compiled into Utility.dll and visible to Renderer + Client
       when classicuo-wasm publishes with -p:IsBrowserWasm=true. -->
  <PropertyGroup Condition="'$(IsBrowserWasm)' == 'true'">
    <DefineConstants>$(DefineConstants);BROWSER_WASM</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\FNA\FNA.Core.csproj" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

</Project>
