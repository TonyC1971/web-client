# uonexus-minimal — copy to .env (note the leading dot) next to docker-compose.minimal.yml and edit.
# Every line here is read by docker-compose.minimal.yml; nothing else is required.

# ── Your UO server ────────────────────────────────────────────────────────────
# Where the proxy opens the TCP connection. NOT defaulted on purpose: a default of
# host.docker.internal would quietly turn this proxy into a way to reach anything on the host's
# network, so it must be stated.
UO_HOST=your.shard.example.com
UO_PORT=2593

# One word, used in FOUR places that must all agree: here, the folder under GAMEFILES_ROOT, the
# `slug:` in your servers/*.yaml, and the `slug` in client/minimal/config.json. None of them fails
# with a message naming the mismatch — you get an empty mount and an endless loading screen, or a
# shard the relay cannot resolve. Lowercase letters, digits and hyphens.
SHARD_SLUG=myshard

# Shown in the client chrome.
SERVER_NAME=My UO Shard

# ── Game files ────────────────────────────────────────────────────────────────
# Directory holding your converted .mul-derived files, laid out as <GAMEFILES_ROOT>/<SHARD_SLUG>/.
# ℹ️ `node server/scripts/precompress-gamefiles.mjs` over it once is a large BANDWIDTH win and is
# not required to boot — measured. The loader asks for each file by name and nginx's brotli_static
# falls back to the raw file when no twin exists. (This note used to say every asset 404s without
# them. That was wrong, and expensive: quality 11 over a full fileset is hours. Use --quality 9.)
GAMEFILES_ROOT=./gamefiles

# ── Web ───────────────────────────────────────────────────────────────────────
# Host port for the client. http://localhost:8080 by default.
PORT=8080

# 🚨 CHANGE THIS. It signs session cookies; the placeholder is not a secret.
#   openssl rand -hex 32
JWT_SECRET=change-me-generate-a-real-secret

# Comma-separated public origins, if you serve this behind a domain (e.g. https://uo.example.com).
# Leave empty for localhost.
PUBLIC_ORIGINS=

# How many reverse proxies sit in front of this stack. 1 = just the bundled nginx. Raise it if you
# add Cloudflare or another proxy, or per-IP rate limits will all see the same address.
TRUST_PROXY_HOPS=1

# ── Discord (OPTIONAL) ────────────────────────────────────────────────────────
# Leave empty and the client stays fully playable: /auth/* answers 503 and players use it as
# guests, with settings persisting in their browser instead of across devices. Fill it in to get
# cloud sync of macros, hotkeys and client settings.
#
# Create an application at https://discord.com/developers/applications, add a redirect URI matching
# DISCORD_REDIRECT_URI exactly, and paste the client id/secret here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback

# Invite link for YOUR community, shown as the Discord icon on the landing page. Unrelated to
# sign-in above: this is just a link. Left empty the icon is removed rather than rendered as a
# dead placeholder, which is what it did before this existed.
DISCORD_INVITE_URL=

# ── Container user ────────────────────────────────────────────────────────────
# Should match the owner of ./data and GAMEFILES_ROOT on the host, or the proxy cannot write its
# database. On Linux: `id -u` and `id -g`.
APP_UID=1000
APP_GID=1000

# Apex domain a login should span, e.g. example.com so play.example.com shares the session.
# LEAVE EMPTY unless you actually serve the client from several subdomains: empty keeps every
# cookie HOST-SCOPED, which is the narrower and safer behaviour.
# COOKIE_DOMAIN=

# Who may open /admin — Discord ids, comma-separated. Empty means nobody, and the panel answers 404
# to everyone (deliberately: a stranger is not told it exists).
#
# To find your id: enable Developer Mode in Discord (User Settings > Advanced), then right-click your
# own name and choose "Copy User ID". Sign in to this install once first, so the account exists.
ADMIN_SUBS=

# Bump to force every browser to re-fetch the client — useful after you replace your game files.
# Any value works; it is compared, not parsed.
CLIENT_EPOCH=1

# The asset worker: how often it looks for new game files, and how hard it compresses them.
# Quality 11 costs hours on a full fileset for a few percent; 9 is a fraction of the time.
WORKER_INTERVAL_SECS=120
BROTLI_QUALITY=9

# Where the proxy looks for the built client bundles (client/minimal and client/minimal-tuo,
# mounted read-only). It uses them to refuse a setting that would point the install at a
# client nobody compiled — the admin panel greys that out, but the panel is the browser and
# the request can be sent directly. Leave it unless your compose mounts them elsewhere.
CLIENT_ROOT=/srv/client
